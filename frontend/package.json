    "@xyflow/react": "^12.7.0",
    "codemirror": "^6.0.1",
    "graphql-request": "^6.1.0",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.1.0",
    "rxjs": "^7.8.1",
    "signal-ts": "^1.2.4",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
